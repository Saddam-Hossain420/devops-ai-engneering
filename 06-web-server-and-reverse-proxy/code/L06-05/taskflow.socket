# /etc/systemd/system/taskflow.socket
# systemd socket ধরে রাখে; প্রথম connection-এ (বা boot-এ) taskflow.service চালু করে, fd 3 হিসেবে দেয়।
# App restart-এর সময়ও socket খোলা থাকে — nginx-এর request queue-তে অপেক্ষা করে, "Connection refused" নয়।

[Unit]
Description=TaskFlow API socket (L06-05)
Documentation=https://www.freedesktop.org/software/systemd/man/latest/systemd.socket.html

[Socket]
ListenStream=/run/taskflow/taskflow.sock
SocketUser=taskflow
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755
Backlog=128

[Install]
WantedBy=sockets.target
