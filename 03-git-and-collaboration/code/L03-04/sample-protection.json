{
  "_comment": "হাতে তৈরি নমুনা — GitHub REST API-র branch protection response-এর আকারে (কয়েকটি field বাদ)। নিজের repository-র আসল JSON `gh api` দিয়ে নিয়ে মিলিয়ে দেখুন।",
  "required_status_checks": {
    "strict": false,
    "contexts": ["validate"],
