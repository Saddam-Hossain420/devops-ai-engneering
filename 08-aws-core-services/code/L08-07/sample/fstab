# হাতে তৈরি /etc/fstab — একটি EC2 (Nitro) Ubuntu instance, ইচ্ছাকৃত ভুলসহ
LABEL=cloudimg-rootfs   /         ext4   discard,commit=30,errors=remount-ro   0 1
LABEL=UEFI              /boot/efi vfat   umask=0077   0 1
/dev/xvdf               /data     ext4   defaults     0 2
UUID=0d2c7d1e-5b6a-4e8f-9c3a-1b2c3d4e5f60  /backup  xfs  defaults,nofail  0 2
fs-0123456789abcdef0.efs.ap-south-1.amazonaws.com:/  /shared  nfs4  nfsvers=4.1,soft,timeo=600  0 0
fs-0fedcba9876543210:/  /uploads  efs  _netdev,tls,iam  0 0
